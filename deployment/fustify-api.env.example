# Keep this file server-only. Only the URL and publishable key may be derived
# into matching VITE_* variables; the service-role key must never be copied.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Prefer the current opaque server key. Keep the legacy key only during
# migration; the API accepts it as a fallback.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_service_role_secret
SUPABASE_PROJECT_REF=replace_with_project_ref
# Set to self-hosted to disable calls to Supabase's hosted Management,
# Metrics, and advisor APIs while preserving application-owned admin features.
SUPABASE_DEPLOYMENT_MODE=hosted
# Fine-grained token requiring analytics_logs_read only. Optional: the admin
# console reports logs as unconfigured when omitted.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=replace_with_fine_grained_token
FUSTIFY_EXPECTED_SUPABASE_MIGRATION=20260730002339
FUSTIFY_ADMIN_MUTATIONS_ENABLED=0
FUSTIFY_API_PORT=8787
