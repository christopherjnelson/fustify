#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

expected_user="${FUSTIFY_DEPLOY_USER:-chris}"
repository="${FUSTIFY_REPOSITORY:-/srv/fustify/repository}"
branch="${FUSTIFY_BRANCH:-main}"
remote="${FUSTIFY_REMOTE:-origin}"
lock_file="${FUSTIFY_DEPLOY_LOCK:-/tmp/fustify-deploy-${expected_user}.lock}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r "${script_dir}/lib.sh" ]]; then
  source "${script_dir}/lib.sh"
else
  source /usr/local/lib/fustify-deploy-lib.sh
fi

fustify_require_non_root_user "${expected_user}"
fustify_validate_absolute_path "FUSTIFY_REPOSITORY" "${repository}"
fustify_validate_absolute_path "FUSTIFY_DEPLOY_LOCK" "${lock_file}"
if [[ ! "${branch}" =~ ^[A-Za-z0-9._/-]+$ || "${branch}" == -* ]]; then
  fustify_error "FUSTIFY_BRANCH contains unsupported characters."
  exit 1
fi
if [[ ! "${remote}" =~ ^[A-Za-z0-9._-]+$ || "${remote}" == -* ]]; then
  fustify_error "FUSTIFY_REMOTE contains unsupported characters."
  exit 1
fi

exec 9>"${lock_file}"
if ! flock -n 9; then
  fustify_error "Another Fustify deployment is already running."
  exit 1
fi

cd "${repository}"
if [[ "$(git branch --show-current)" != "${branch}" ]]; then
  fustify_error "Repository must be on branch ${branch}."
  exit 1
fi
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  fustify_error "Tracked repository files are dirty; refusing deployment."
  exit 1
fi

git fetch --prune "${remote}" "${branch}"
remote_ref="${remote}/${branch}"
if ! git merge-base --is-ancestor HEAD "${remote_ref}"; then
  fustify_error "Local ${branch} is ahead of or diverged from ${remote_ref}."
  exit 1
fi
git merge --ff-only "${remote_ref}"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  fustify_error "Tracked repository files changed unexpectedly after update."
  exit 1
fi

export FUSTIFY_SOURCE_UPDATED=1
exec bash "${repository}/deployment/deploy.sh"
