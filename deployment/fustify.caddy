dev.fustify.com {
	@blocked path_regexp blocked "(^|/)(\\.[^/]+|src(/|$)|node_modules(/|$))|\\.map$"
	respond @blocked 404

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/fustify/current/web

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@html {
			not path /assets/*
		}
		header @html Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
