# These values are appended to the pinned upstream .env during installation.
# Replace every replace_* value before starting the production stack.
COMPOSE_FILE=docker-compose.yml:docker-compose.fustify.yml

FUSTIFY_SUPABASE_DOMAIN=supabase.example.com
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com/auth/v1
SITE_URL=https://dev.fustify.com
ADDITIONAL_REDIRECT_URLS=https://dev.fustify.com/auth/callback,https://dev.fustify.com/auth/reset-password

ENABLE_ANONYMOUS_USERS=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

SMTP_ADMIN_EMAIL=replace_sender@example.com
SMTP_HOST=replace_smtp_host
SMTP_PORT=465
SMTP_USER=replace_smtp_user
SMTP_PASS=replace_smtp_password
SMTP_SENDER_NAME=Fustify

DISCORD_ENABLED=true
DISCORD_CLIENT_ID=replace_discord_client_id
DISCORD_CLIENT_SECRET=replace_discord_client_secret
DISCORD_WEBHOOK=replace_discord_webhook
DISCORD_ROOM_ANNOUNCEMENT_INVOCATION_SECRET=replace_high_entropy_secret

STUDIO_DEFAULT_ORGANIZATION=Fustify
STUDIO_DEFAULT_PROJECT=Fustify Multiplayer
OPENAI_API_KEY=
POOLER_TENANT_ID=fustify
STORAGE_TENANT_ID=fustify
GLOBAL_S3_BUCKET=fustify
REGION=local
FUNCTIONS_VERIFY_JWT=false
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
