VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
# Server-only. Never prefix this name with VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_secret
# Use self-hosted to disable hosted-only administration API calls.
SUPABASE_DEPLOYMENT_MODE=hosted
# Optional; shared by the Node API and Vite proxy.
FUSTIFY_API_PORT=8787
