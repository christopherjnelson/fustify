{
  "name": "fustify",
  "description": "A procedural globe strategy game.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/core",
    "test:simulation": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts",
    "test:simulation:stress": "SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts",
    "test:simulation:replay": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts -t 'replays the configured failing seed'",
    "test:bot": "vitest run --disableConsoleIntercept src/core/controllers src/core/simulation/botMatch.test.ts",
    "test:bot:stress": "BOT_SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/botMatch.test.ts",
    "simulate:bots": "tsx scripts/simulateBots.ts",
    "test:e2e": "playwright test tests/e2e/interactions.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.182.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
