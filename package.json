{
  "name": "fustify",
  "description": "A procedural globe strategy game.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:analyze": "tsc -b && vite build --mode bundle-analysis",
    "bundle:check": "pnpm bundle:analyze && node --experimental-strip-types scripts/checkBundle.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/core",
    "test:simulation": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts",
    "test:simulation:stress": "SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts",
    "test:simulation:replay": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts -t 'replays the configured failing seed'",
    "test:bot": "vitest run --disableConsoleIntercept src/core/controllers src/core/simulation/botMatch.test.ts",
    "test:bot:stress": "BOT_SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/botMatch.test.ts",
    "simulate:bots": "tsx scripts/simulateBots.ts",
    "study:balance": "node --import tsx scripts/balanceStudy.ts",
    "test:e2e": "playwright test tests/e2e/interactions.spec.ts tests/e2e/admin.spec.ts",
    "test:e2e:multiplayer": "playwright test tests/e2e/multiplayer.spec.ts tests/e2e/multiplayer-lobby-layout.spec.ts --project=desktop-1920 && playwright test tests/e2e/multiplayer.mobile.spec.ts --project=mobile-390",
    "test:visual:multiplayer": "playwright test tests/e2e/multiplayer.visual.spec.ts",
    "test:visual:multiplayer:update": "playwright test tests/e2e/multiplayer.visual.spec.ts --update-snapshots",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:world-visual": "WORLD_AUDIT_PHASE=corrected playwright test tests/e2e/world-generation.visual.spec.ts && WORLD_AUDIT_PHASE=corrected node --import tsx scripts/worldGenerationReport.ts",
    "audit:world-visual": "WORLD_AUDIT_PHASE=${WORLD_AUDIT_PHASE:-audit} WORLD_AUDIT_ALLOW_FAILURES=1 playwright test tests/e2e/world-generation.visual.spec.ts && WORLD_AUDIT_PHASE=${WORLD_AUDIT_PHASE:-audit} node --import tsx scripts/worldGenerationReport.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:report": "tsx scripts/verifyReport.ts",
    "verify:report:full": "tsx scripts/verifyReport.ts --full",
    "supabase:link": "SUPABASE_TELEMETRY_DISABLED=1 supabase link --project-ref qwmsybhpjnfjiyxcspwj",
    "supabase:config:push": "SUPABASE_TELEMETRY_DISABLED=1 supabase config push --project-ref qwmsybhpjnfjiyxcspwj",
    "supabase:migrations:list": "SUPABASE_TELEMETRY_DISABLED=1 supabase migration list --linked",
    "supabase:db:push": "SUPABASE_TELEMETRY_DISABLED=1 supabase db push --linked",
    "supabase:test:db": "SUPABASE_TELEMETRY_DISABLED=1 supabase test db supabase/tests",
    "supabase:types": "SUPABASE_TELEMETRY_DISABLED=1 supabase gen types --project-id qwmsybhpjnfjiyxcspwj --schema public > src/multiplayer/database.types.ts",
    "test:multiplayer:concurrency": "node --env-file-if-exists=.env.local --import tsx scripts/testMultiplayerConcurrency.ts",
    "test:multiplayer:authority": "node --env-file-if-exists=.env.local --import tsx scripts/testAuthoritativeMultiplayer.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@supabase/supabase-js": "2.110.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.182.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "2.109.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
