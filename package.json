{
  "name": "fustify",
  "description": "A procedural globe strategy game.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "tsc -b && vite build",
    "build:api": "vite build --config vite.api.config.ts",
    "build:release": "pnpm build && pnpm build:api && node --experimental-strip-types scripts/buildRelease.ts",
    "clean": "node --experimental-strip-types scripts/cleanGenerated.ts --transient",
    "clean:reports": "node --experimental-strip-types scripts/cleanGenerated.ts --reports",
    "clean:all": "node --experimental-strip-types scripts/cleanGenerated.ts --all",
    "deploy:droplet": "bash deployment/deploy.sh",
    "bundle:analyze": "tsc -b && vite build --mode bundle-analysis",
    "bundle:check": "pnpm bundle:analyze && node --experimental-strip-types scripts/checkBundle.ts",
    "test": "vitest run",
    "test:deployment": "vitest run --config vitest.deployment.config.ts",
    "test:watch": "vitest",
    "test:names": "NAMING_AUDIT=1 vitest run src/core/generation/naming/generateGeographicNames.test.ts",
    "test:integration:dev-proxy": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage src/core/game src/core/persistence/saveGame.test.ts src/core/simulation/simulator.test.ts",
    "test:simulation": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts",
    "test:simulation:stress": "SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts -t 'runs 135 world/setup combinations through both policies'",
    "test:simulation:replay": "vitest run --disableConsoleIntercept src/core/simulation/simulator.test.ts -t 'replays the configured failing seed'",
    "test:bot": "vitest run --disableConsoleIntercept src/core/controllers src/core/simulation/botMatch.test.ts",
    "test:bot:stress": "BOT_SIMULATION_STRESS=1 vitest run --disableConsoleIntercept src/core/simulation/botMatch.test.ts -t 'runs the moderate bot stress matrix'",
    "simulate:bots": "tsx scripts/simulateBots.ts",
    "study:balance": "node --import tsx scripts/balanceStudy.ts",
    "test:e2e": "playwright test tests/e2e/interactions.spec.ts tests/e2e/mobile-gameplay.spec.ts tests/e2e/multiplayer-browser.spec.ts tests/e2e/home-navigation.spec.ts tests/e2e/home-world-preview.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/account-auth.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:world-visual": "WORLD_AUDIT_PHASE=corrected playwright test tests/e2e/world-generation.visual.spec.ts && WORLD_AUDIT_PHASE=corrected node --import tsx scripts/worldGenerationReport.ts",
    "audit:world-visual": "WORLD_AUDIT_PHASE=${WORLD_AUDIT_PHASE:-audit} WORLD_AUDIT_ALLOW_FAILURES=1 playwright test tests/e2e/world-generation.visual.spec.ts && WORLD_AUDIT_PHASE=${WORLD_AUDIT_PHASE:-audit} node --import tsx scripts/worldGenerationReport.ts",
    "audit:normalized-worlds": "node --import tsx scripts/normalizedWorldSweep.ts",
    "names:generate": "node --experimental-strip-types scripts/generateGeographicNameAssets.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:report": "tsx scripts/verifyReport.ts",
    "verify:report:full": "tsx scripts/verifyReport.ts --full"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "better-auth": "^1.7.1",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.182.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  }
}
